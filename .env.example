# 应用配置
NODE_ENV=development
PORT=3000

# 数据库配置（Docker 容器内使用服务名作为主机）
DB_HOST=mysql
DB_PORT=3306
DB_USER=developer
DB_PASSWORD=abcd1234
DB_NAME=mydatabase

# 如果从宿主机连接数据库，使用以下配置
# DB_HOST=localhost
# DB_PORT=3307

# Redis 配置（Docker 容器内使用服务名作为主机）
REDIS_HOST=redis
REDIS_PORT=6379

# 如果从宿主机连接 Redis，使用以下配置
# REDIS_HOST=localhost
# REDIS_PORT=6379

# JWT 配置
JWT_SECRET=your-secret-key-change-this-in-production
